{
  "name": "@spostorage/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node -e \"const fs=require('node:fs');fs.cpSync('src/db/migrations-sql','dist/db/migrations-sql',{recursive:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:v2": "vitest run",
    "lint": "eslint src test --ext .ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@azure/identity": "^4.13.3",
    "@azure/storage-blob": "^12.33.0",
    "@fastify/cors": "^10.0.2",
    "@fastify/static": "^8.0.4",
    "@spostorage/shared": "*",
    "fastify": "^5.2.0",
    "mssql": "^11.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/mssql": "^9.1.11",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
